# Banco de dados
DATABASE_URL="postgresql://linkedai:linkedai@localhost:5432/linkedai?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="gere-com: openssl rand -base64 32"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Storage (currículos)
STORAGE_PROVIDER="local" # local | s3 | supabase
STORAGE_BUCKET="linkedai-resumes"

# Redis (filas - usado a partir da Fase 2)
REDIS_URL="redis://localhost:6379"

# Chave de criptografia de dados sensíveis (AES-256)
ENCRYPTION_KEY="gere-com: openssl rand -hex 32"
